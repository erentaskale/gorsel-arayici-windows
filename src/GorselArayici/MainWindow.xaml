<Window x:Class="GorselArayici.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Görsel Arayıcı" Height="600" Width="760"
        Background="#FBF7F2" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="GorunurYap" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Görsel Arayıcı" FontSize="26" FontWeight="SemiBold" Foreground="#3B2F2A" />
        <StackPanel Grid.Row="1" Margin="0,4,0,16">
            <TextBlock Text="{Binding Durum}" Foreground="#8A7B72" />
            <StackPanel Visibility="{Binding Taraniyor, Converter={StaticResource GorunurYap}}" Margin="0,8,0,0">
                <ProgressBar Value="{Binding IlerlemeYuzde}" Height="6"
                             Foreground="#D9895B" Background="#EDE4DA" BorderThickness="0" />
                <TextBlock Text="{Binding SonOkunan}" Foreground="#A89A90" FontSize="12"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <!-- Sanallaştırma: 12 bin satırın yalnız ekranda görüneni çizilir -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Resimler}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 Background="White" BorderBrush="#EDE4DA" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6,4">
                        <TextBlock Text="{Binding Ad}" Foreground="#3B2F2A" />
                        <TextBlock Text="{Binding Klasor}" Foreground="#A89A90" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>

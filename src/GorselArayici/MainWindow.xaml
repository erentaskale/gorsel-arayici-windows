<Window x:Class="GorselArayici.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Görsel Arayıcı" Height="760" Width="1100"
        Background="#FBF7F2" FontFamily="Segoe UI" FontSize="14"
        FocusManager.FocusedElement="{Binding ElementName=AramaKutusu}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="GorunurYap" />

        <!-- Sıralama seçimi için yuvarlak "hap" düğmeler -->
        <Style x:Key="Hap" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Zemin" CornerRadius="12" Padding="12,4" Background="White"
                                BorderBrush="#E3D6C8" BorderThickness="1">
                            <TextBlock x:Name="Yazi" Text="{TemplateBinding Content}" FontSize="12"
                                       Foreground="#8A7B72" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Zemin" Property="Background" Value="#D9895B" />
                                <Setter TargetName="Zemin" Property="BorderBrush" Value="#D9895B" />
                                <Setter TargetName="Yazi" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Görsel Arayıcı" FontSize="26" FontWeight="SemiBold" Foreground="#3B2F2A" />
        <StackPanel Grid.Row="1" Margin="0,4,0,16">
            <TextBlock Text="{Binding Durum}" Foreground="#8A7B72" />
            <StackPanel Visibility="{Binding Taraniyor, Converter={StaticResource GorunurYap}}" Margin="0,8,0,0">
                <ProgressBar Value="{Binding IlerlemeYuzde}" Height="6"
                             Foreground="#D9895B" Background="#EDE4DA" BorderThickness="0" />
                <TextBlock Text="{Binding SonOkunan}" Foreground="#A89A90" FontSize="12"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <!-- Arama kutusu. WPF'te hazır "silik ipucu yazısı" yok; kutu boşken arkadaki yazı görünür. -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E3D6C8" BorderThickness="1"
                CornerRadius="10" Padding="12,8">
            <Grid>
                <TextBlock Text="Resimlerin üzerindeki bir kelimeyi yaz…" Foreground="#B9ABA0"
                           IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=AramaKutusu}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox x:Name="AramaKutusu" FontSize="16" Foreground="#3B2F2A"
                         Background="Transparent" BorderThickness="0"
                         Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!-- Sonuç bilgisi solda, sıralama seçimi sağda -->
        <DockPanel Grid.Row="3" Margin="4,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Sırala:" Foreground="#8A7B72" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <!-- Aynı gruptaki iki düğmeden biri seçilince öbürü kendiliğinden kalkar -->
                <RadioButton GroupName="Sira" Content="En yeni" IsChecked="{Binding TariheGore}"
                             Style="{StaticResource Hap}" />
                <RadioButton GroupName="Sira" Content="En alakalı" Style="{StaticResource Hap}" />
            </StackPanel>
            <TextBlock Text="{Binding SonucBilgisi}" Foreground="#8A7B72" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Arama kutusu boşken gösterilen ipucu -->
        <TextBlock Grid.Row="4" Text="Bir kelime yaz; üzerinde o yazı geçen resimler burada belirsin."
                   Foreground="#B9ABA0" HorizontalAlignment="Center" Margin="0,60,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=AramaKutusu}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Sonuçlar: önizlemeli kutular, pencere genişliğine göre satır satır dizilir -->
        <ListBox x:Name="SonucListesi" Grid.Row="4" ItemsSource="{Binding Liste}" Margin="-6,8,-6,0"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- Seçili resmi Enter ile aç (çift tık kod tarafında) -->
            <ListBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding AcCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=SonucListesi}" />
            </ListBox.InputBindings>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <!-- Varsayılan mavi seçim yerine sıcak renkli ince çerçeve -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Kutu" Background="White" CornerRadius="12"
                                        BorderBrush="#EDE4DA" BorderThickness="1.5" Padding="8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Kutu" Property="BorderBrush" Value="#E9B996" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Kutu" Property="BorderBrush" Value="#D9895B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="190" ToolTip="{Binding Ad}">
                        <Border Height="240" CornerRadius="8" Background="#F5EFE8" ClipToBounds="True">
                            <Image Source="{Binding Onizleme}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding TarihYazisi}" Foreground="#3B2F2A" FontSize="12"
                                   FontWeight="SemiBold" Margin="2,8,2,0" />
                        <TextBlock Text="{Binding Ozet}" Foreground="#8A7B72" FontSize="12"
                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                   Margin="2,2,2,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>

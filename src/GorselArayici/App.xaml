<!-- Pencere App.xaml.cs'te açılır (önce "başka kopya açık mı?" diye bakılır), bu yüzden StartupUri yok. -->
<Application x:Class="GorselArayici.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
        <!-- ===== Renkler Temalar\Acik.xaml ve Temalar\Koyu.xaml'de. Açılışta biri yüklenir; tema değişince
             Tema.cs bu sıradaki sözlüğü ötekiyle değiştirir. Renkler DynamicResource ile okunduğu için
             her şey anında yeni renge geçer (StaticResource bir kez okur, değişikliği görmez). ===== -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Temalar/Acik.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- Font: DM Sans uygulamanın içine gömülü; bulunamazsa Windows'un kendi fontu -->
        <FontFamily x:Key="Font">pack://application:,,,/Assets/Fonts/#DM Sans, Segoe UI</FontFamily>

        <BooleanToVisibilityConverter x:Key="GorunurYap" />

        <!-- Logonun vektör hali: uygulama içinde her boyutta keskin görünsün diye (.ico büyütülünce bulanıklaşıyor).
             Ölçüler logo.ico'yu çizen taslakla aynı: 100x100'lük kare. -->
        <DrawingImage x:Key="Logo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#3F7D5C">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="1,1,98,98" RadiusX="23" RadiusY="23" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1F2A24" Thickness="11" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="64,64" EndPoint="84,84" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F6F7F4">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="44,44" RadiusX="26" RadiusY="26" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#A9CDB4">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="52,35" RadiusX="5" RadiusY="5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8FB59D" Geometry="M25,55 L37,41 45,49 51,44 63,55 Z" />
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1F2A24" Thickness="7" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="44,44" RadiusX="26" RadiusY="26" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ===== İnce kaydırma çubuğu: Windows'un gri çubuğu koyu temada sırıtıyordu =====
             Ok düğmeleri yok; yalnız yuvarlak bir tutamaç. Rengi temadan gelir. -->
        <Style x:Key="BosAlan" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tutamac" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Govde" CornerRadius="4" Margin="2" Background="{DynamicResource KenarKoyu}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Govde" Property="Background" Value="{DynamicResource SolukYazi}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Govde" Property="Background" Value="{DynamicResource SolukYazi}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource BosAlan}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource BosAlan}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Tutamac}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Yatay çubuk (şu an kullanılmıyor ama bir yerde çıkarsa düzgün dursun) -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource BosAlan}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource BosAlan}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Tutamac}" />
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sade, yuvarlak köşeli düğme -->
        <Style x:Key="Dugme" TargetType="Button">
            <!-- Yazı/simge rengi temadan. Açıkça verilmezse Windows'un siyahı gelir ve koyu temada simge kaybolur. -->
            <Setter Property="Foreground" Value="{DynamicResource Yazi}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Zemin" CornerRadius="12" Padding="16,8" Background="{DynamicResource Yuzey}"
                                BorderBrush="{DynamicResource Kenar}" BorderThickness="1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Zemin" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Yuvarlak simge düğmesi: önceki / sonraki / kapat -->
        <Style x:Key="Yuvarlak" TargetType="Button" BasedOn="{StaticResource Dugme}">
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Zemin" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Yuzey}"
                                BorderBrush="{DynamicResource Kenar}" BorderThickness="1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="18"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Zemin" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<!-- Pencere App.xaml.cs'te açılır (önce "başka kopya açık mı?" diye bakılır), bu yüzden StartupUri yok. -->
<Application x:Class="GorselArayici.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- ===== Adaçayı paleti: bütün renkler buradan gelir, tek yerden değişir ===== -->
        <SolidColorBrush x:Key="Zemin" Color="#F6F7F4" />
        <SolidColorBrush x:Key="Panel" Color="#ECEFE8" />
        <SolidColorBrush x:Key="Beyaz" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Kenar" Color="#DCE3D9" />
        <SolidColorBrush x:Key="KenarKoyu" Color="#C8D3C4" />
        <SolidColorBrush x:Key="Yazi" Color="#1F2A24" />
        <SolidColorBrush x:Key="SolukYazi" Color="#7C8780" />
        <SolidColorBrush x:Key="Vurgu" Color="#3F7D5C" />
        <SolidColorBrush x:Key="VurguAcik" Color="#DCEBDF" />
        <SolidColorBrush x:Key="ResimBos" Color="#E6EBE3" />

        <!-- Font: DM Sans uygulamanın içine gömülü; bulunamazsa Windows'un kendi fontu -->
        <FontFamily x:Key="Font">pack://application:,,,/Assets/Fonts/#DM Sans, Segoe UI</FontFamily>

        <BooleanToVisibilityConverter x:Key="GorunurYap" />

        <!-- Logonun vektör hali: uygulama içinde her boyutta keskin görünsün diye (.ico büyütülünce bulanıklaşıyor).
             Ölçüler logo.ico'yu çizen taslakla aynı: 100x100'lük kare. -->
        <DrawingImage x:Key="Logo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#3F7D5C">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="1,1,98,98" RadiusX="23" RadiusY="23" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1F2A24" Thickness="11" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="64,64" EndPoint="84,84" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F6F7F4">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="44,44" RadiusX="26" RadiusY="26" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#A9CDB4">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="52,35" RadiusX="5" RadiusY="5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8FB59D" Geometry="M25,55 L37,41 45,49 51,44 63,55 Z" />
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1F2A24" Thickness="7" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="44,44" RadiusX="26" RadiusY="26" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Sıralama seçimi için yuvarlak "hap" düğmeler -->
        <Style x:Key="Hap" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Zemin" CornerRadius="14" Padding="14,6" Background="{StaticResource Beyaz}"
                                BorderBrush="{StaticResource Kenar}" BorderThickness="1">
                            <TextBlock x:Name="Yazi" Text="{TemplateBinding Content}" FontSize="13"
                                       Foreground="{StaticResource SolukYazi}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource KenarKoyu}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Zemin" Property="Background" Value="{StaticResource Vurgu}" />
                                <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource Vurgu}" />
                                <Setter TargetName="Yazi" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sade, yuvarlak köşeli düğme -->
        <Style x:Key="Dugme" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Zemin" CornerRadius="12" Padding="16,8" Background="{StaticResource Beyaz}"
                                BorderBrush="{StaticResource Kenar}" BorderThickness="1">
                            <ContentPresenter TextElement.Foreground="{StaticResource Yazi}" TextElement.FontSize="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource Vurgu}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Yuvarlak simge düğmesi: önceki / sonraki / kapat -->
        <Style x:Key="Yuvarlak" TargetType="Button" BasedOn="{StaticResource Dugme}">
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Zemin" Width="44" Height="44" CornerRadius="22" Background="{StaticResource Beyaz}"
                                BorderBrush="{StaticResource Kenar}" BorderThickness="1">
                            <ContentPresenter TextElement.Foreground="{StaticResource Yazi}" TextElement.FontSize="18"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource Vurgu}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

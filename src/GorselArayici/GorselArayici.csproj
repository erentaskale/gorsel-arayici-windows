<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows.Media.Ocr gibi Windows API'leri için sürüm numaralı hedef gerekir -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- .exe dosyasının simgesi (masaüstü, Başlat menüsü, Dosya Gezgini) -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pencerenin ve görev çubuğunun simgesi için uygulamanın içine gömülür -->
    <Resource Include="Assets\logo.ico" />
    <!-- DM Sans (SIL Open Font License, Assets\Fonts\OFL.txt): her bilgisayarda aynı görünsün diye gömülü -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>

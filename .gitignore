!/src/**/*.xaml
!/src/**/*.csproj

# Derleme çıktıları (src içinde oluşur)
bin/
obj/

# Kişisel veri asla girmez: resim, video, veritabanı
# (yukarıdaki beyaz liste zaten engeller, bu ikinci kilit)
*.png
*.jpg
*.jpeg
*.heic
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.mp4
*.mov
*.db
